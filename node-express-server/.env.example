# Copia este archivo como .env y ajusta los valores. El archivo .env no se versiona.
# Docker Compose no lee este archivo: con `docker compose up -d`, conserva estos valores
# o pásalos con `docker compose --env-file node-express-server/.env up -d`.
# Un DB_USER distinto también exige cambiar el GRANT de docker/mysql-init.
DB_HOST=localhost
DB_PORT=3306
DB_USER=tutorials_app
DB_PASSWORD=cambia_esto
DB_NAME=tutorials
PORT=8080
CORS_ORIGIN=http://localhost:8081
